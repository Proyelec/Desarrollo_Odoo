<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_hide_bi_convert_buttons" model="ir.ui.view">
        <field name="name">sale.order.form.hide.bi.convert.buttons</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="bi_convert_purchase_from_sales.sale_order_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='%(bi_convert_purchase_from_sales.action_transientmodel_wizard)d']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//button[@name='action_open_purchase_order']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_sale_order_form_so_to_po" model="ir.ui.view">
        <field name="name">sale.order.form.so_to_po</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" icon="fa-list">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="x_kpi_ganado_lines"/>/<field name="x_kpi_total_lines"/>
                        </span>
                        <span class="o_stat_text">Ganado</span>
                    </div>
                </button>
                <button class="oe_stat_button" icon="fa-percent">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="x_kpi_conversion_rate"/>%
                        </span>
                        <span class="o_stat_text">Conversión</span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//field[@name='order_line']/tree//field[@name='price_unit']" position="after">
                <field name="x_studio_ganado" optional="show"/>
            </xpath>

        </field>
    </record>

    <record id="view_sale_order_tree_so_to_po" model="ir.ui.view">
        <field name="name">sale.order.tree.so_to_po</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total']" position="after">
                <field name="x_kpi_conversion_label"
                       string="Ganado"
                       optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
