<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_departamento_medular_list" model="ir.ui.view">
        <field name="name">proyelec.departamento.medular.list</field>
        <field name="model">proyelec.departamento.medular</field>
        <field name="arch" type="xml">
            <tree string="Departamentos Medulares">
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_departamento_medular_form" model="ir.ui.view">
        <field name="name">proyelec.departamento.medular.form</field>
        <field name="model">proyelec.departamento.medular</field>
        <field name="arch" type="xml">
            <form string="Departamento Medular">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_departamento_medular" model="ir.actions.act_window">
        <field name="name">Departamentos Medulares</field>
        <field name="res_model">proyelec.departamento.medular</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{"active_test": False}</field>
    </record>

    <menuitem
        id="menu_departamento_medular"
        name="Departamentos Medulares"
        parent="sale.menu_sale_config"
        action="action_departamento_medular"
        groups="base.group_system"
        sequence="99"
    />
</odoo>
