<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="split_move_form_view" model="ir.ui.view">
        <field name="name">account.move</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']//tree//field[@name='product_id']" position="before">
                <button name="btn_tick_untick" type="object" class="oe_stat_button btn-primary"
                    string="Tick/Untick" groups="sh_split_invoice.group_split_invoice"
                    column_invisible="parent.state != 'draft'" ></button>
                <field name="tick" groups="sh_split_invoice.group_split_invoice"
                    readonly="parent.state != 'draft'" />
            </xpath>
            <xpath expr="//field[@name='line_ids']//tree//field[@name='account_id']" position="before">
                <button name="btn_tick_untick" type="object" class="oe_stat_button btn-primary"
                    string="Tick/Untick" groups="sh_split_invoice.group_split_invoice"
                    column_invisible="parent.state != 'draft'" />
                <field name="tick" groups="sh_split_invoice.group_split_invoice"
                    readonly="parent.state != 'draft'" />
            </xpath>
            <xpath expr="//header/button[@name='button_cancel']" position="after">
                <button name="action_split" invisible="state != 'draft'" type="object"
                    string="Split" groups="sh_split_invoice.group_split_invoice" />
            </xpath>
            <xpath expr="//header/button[@name='button_cancel']" position="after">
                <button name="action_extract" invisible="state != 'draft'" type="object"
                    string="Extract" groups="sh_split_invoice.group_split_invoice" />
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']" position="before">
                <div class="o_row" style="margin: 15px 0;">
                    <button name="action_check" icon="fa-check" title="Check" class="btn btn-primary" type="object" groups="sh_split_invoice.group_split_invoice" />
                    <button name="action_uncheck" icon="fa-close" title="Uncheck" class="btn btn-primary" type="object" groups="sh_split_invoice.group_split_invoice" />
                </div>
            </xpath>
            <field name="payment_reference" position="after">
                <field name="extract_id" invisible="not extract_id" groups="sh_split_invoice.group_split_invoice" />
                <field name="split_id" invisible="not split_id" groups="sh_split_invoice.group_split_invoice" />
            </field>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_extract_invoice" type="object" class="oe_stat_button"
                    groups="sh_split_invoice.group_split_invoice" icon="fa-file-archive-o"
                    invisible="extract_count == 0" >
                    <field name="extract_count" widget="statinfo" string="Extracted" />
                </button>
                <button name="action_view_split_invoice" type="object" class="oe_stat_button"
                    groups="sh_split_invoice.group_split_invoice" icon="fa-chain-broken"
                    invisible="split_count == 0">
                    <field name="split_count" widget="statinfo" string="Splited" />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
