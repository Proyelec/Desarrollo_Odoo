<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <!-- Split Configurations -->
    <record id="sh_split_invoice_remove_qty_res_config_settings" model="ir.ui.view">
        <field name="name">Split Configurations</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//app[@name='account']//block[@name='fiscal_localization_setting_container']"
                position="after">
                <block title="Split Configurations" groups="sh_split_invoice.group_split_invoice">
                    <setting company_dependent="1">
                        <field name="sh_invoice_remove_qty" />
                    </setting>
                </block>
            </xpath>

        </field>
    </record>
</odoo>