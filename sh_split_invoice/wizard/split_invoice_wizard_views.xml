<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sh_split_invoice_wizard_view" model="ir.ui.view">
        <field name="name">sh.split.invoice.wizard</field>
        <field name="model">sh.split.invoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Split Invoice/Bill/Credit Note/Debit Note">
                <notebook>
                    <page string="Dividir Líneas" name="split_line_ids">
                        <field name="split_line_ids" widget="section_and_note_one2many" mode="tree" >
                            <tree editable="bottom" create="false" delete="false">
                                <field name="product_id" readonly="1" force_save="1" required="1"/>
                                <field name="qty" required="1"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button string="Dividir" type="object" name="action_split" class="btn-primary" />or
                    <button name="cancel" string="Cancelar" special="cancel" class="oe_link" />
                </footer>
            </form>
        </field>
    </record>
    <record id="sh_split_invoice_wizard_action" model="ir.actions.act_window">
        <field name="name">Split Invoice/Bill/Credit Note/Debit Note</field>
        <field name="res_model">sh.split.invoice.wizard</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
