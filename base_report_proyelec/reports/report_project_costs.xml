<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_project_costs_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context(lang=lang)"/>
            <div class="page">
                <div class="container-fluid">
                  <div class="row">
                        <div class="col">
                            <h2 class="text-center">Informe de Costos de Proyectos</h2>
                            <div style="background-color: lightblue; height: 40px;"/>
                        </div>
                    </div>
                 </div>

                 <t t-set="amount_total_inv" t-value="o.action_view_invoice_reporPDF(False)"/>
                 <t t-set="amount_total_sale" t-value="o.action_view_invoice_reporPDF(True)"/>
                 <t t-set="amount_estimate_cts" t-value="o.getEstimateCost()"/>
                 <t t-set="amount_revenue" t-value="o.getEstimateRevenue()"/>
                 <t t-set="amount_utility" t-value="o.getRealUtility()"/>

                 

                 

                 <t t-set="amount_total_invPurchase" t-value="o.action_view_vendor_bill_reporPDF(True)"/>

                <table class="" style="width:100%;border: 1px solid transparent;">
                    <tbody>
                    
                    <tr>
                        <td class="text-center" style="width:250px;padding:15px;font-size:12px;">
                           <strong><span>Fecha</span></strong> 
                            <br/>
                            <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/>  
                          
                        </td>
                        <td style="width:200px;font-size:12px;">
                            <strong><span>Proyecto</span></strong> 
                           
                            <br/>
                            <span t-esc="o.code"/>
                        
                        </td>
                        <td style="padding:15px;font-size:12px;">
                  
                             <strong><span>Descripcioón</span></strong>
                             <br/>
                             <span t-esc="o.name"/>
                      
                        
                        </td>
                        <td style="width:180px;padding:15px;font-size:12px;">
                            <strong><span>Grupo de Proyecto</span></strong>
                            <br/>        
                            <span t-esc="o.plan_id.display_name"/>
                              
                        
                        </td>
                        <td style="padding:15px;font-size:12px;" colspan="3">
                      
                            <strong><span>Cliente</span></strong><br/>
                            <span t-esc="o.partner_id.display_name"/>
                        </td>
               
                    </tr>
                      
                    <tr class="mt-2">
                        <td class="text-center" style="font-size:12px;padding:15px;">
                           <strong><span>Total OV</span></strong> 
                            <br/>
                            <span t-esc="amount_total_sale" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>  
                          
                        </td>
                        <td style="padding:15px;font-size:12px;">
                            <strong><span>Total Venta Proyecto</span></strong> 
                           
                            <br/>
                              <span t-esc="amount_total_inv" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                        
                        </td>
                        <td style="padding:15px;font-size:12px;">
                  
                             <strong><span>Costo Real</span></strong>
                             <span t-esc="amount_total_invPurchase" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>

                             
                             <br/>
                             
                        
                        </td>
                        <td style="padding:15px;font-size:12px;">
                            <strong><span>Costo Estimado</span></strong><br/>
                            <span t-esc="amount_estimate_cts" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>

                            
                     
                              
                        
                        </td>
                        <td style="padding:15px;font-size:12px;">
                            <strong><span>Utilidad Estimada</span></strong><br/>
                            <span t-esc="amount_revenue" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/> 
                        </td>
                        <td style="padding:15px;font-size:12px;">
                      
                            <strong><span>Utilidad Real</span></strong><br/>
                            <span t-esc="amount_utility" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/> 

                            
                            
                    
                        </td>
                        <td style="width:150px;padding:15px;font-size:12px;">
                      
                            <strong><span>% Ahorro Logistico </span></strong><br/>
                             <span t-esc="round(amount_total_invPurchase / amount_estimate_cts,2)" />%
                        
                        </td>
                    </tr>
      
                     
                    </tbody>
                </table>
                <div>
                     <h2 class="text-center">Detalle de Egresos</h2>
                     <t t-set="purchase_invoice" t-value="o.action_view_vendor_bill_reporPDF()"/>
                     

                     
                     <table class="w-100">
                           <tr style="background-color: lightblue;">
                                <th style="padding:15px;">Fecha de Pago</th>
                                <th style="padding:15px;">No. Documento</th>
                                <th style="padding:15px;">Código Proveedor</th>
                                <th style="padding:15px;">Proveedor</th>
                                <th style="padding:15px;">Pago</th>
                            </tr>
                            <tr t-foreach="purchase_invoice" t-as="move">
                                 <t t-set="pay" t-value="move.action_get_totalPaymentsPDF()"/>
                                <td style="padding:10px;font-size:12px;">
                                    <span t-esc="move.invoice_date.strftime('%d/%m/%Y')"/>
                                </td>
                                <td style="padding:10px;font-size:12px;">
                                    <span t-esc="move.name"/>
                                    
                                </td>
                          
                                <td style="padding:10px;font-size:12px;">
                                    <span t-esc="move.partner_id.vat"/>
                                  
                                </td>
                                <td style="padding:10px;font-size:12px;">
                                      <span t-esc="move.partner_id.name"/>
                                </td>
                                <td style="padding:10px;font-size:12px;">
                                    <t t-if="pay">
                                        <span t-esc="pay" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: move.currency_id}"/>
                                    </t>
                                </td>
                            </tr>

                     </table>
                </div>
            </div>
            
        </t>
    </template>

    <template id="report_project_costs">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang"/>
                <t t-call="base_report_proyelec.report_project_costs_document" t-lang="lang"/>
            </t>
        </t>
    </template>
    <record id="action_report_project_costs" model="ir.actions.report">
        <field name="name">Costos de Proyectos</field>
        <field name="type">ir.actions.report</field>
        <field name="model">account.analytic.account</field>
        <field name="report_name">base_report_proyelec.report_project_costs</field>
        <field name="report_file">base_report_proyelec.report_project_costs</field>
        <field name="report_type">qweb-pdf</field>
        <field name="print_report_name">"Cotos de Proyecto - %s" % (object.name or '')</field>
        <field name="binding_model_id" ref="analytic.model_account_analytic_account"/>
        <field name="binding_type">report</field>   
    </record>

</odoo>